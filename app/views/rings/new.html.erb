<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <h1 class="mb-4">New Ring</h1>

    <% if @ring.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @ring.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @ring do |f| %>
      <div class="mb-4">
        <%= f.label :topic, "Topic", class: "form-label fw-semibold" %>
        <%= f.text_field :topic, class: "form-control #{"is-invalid" if @ring.errors[:topic].any?}",
              placeholder: "e.g. Practical applications of network theory in community organizing" %>
        <% if @ring.errors[:topic].any? %>
          <div class="invalid-feedback"><%= @ring.errors[:topic].first %></div>
        <% end %>
      </div>

      <div class="mb-4">
        <span class="form-label fw-semibold d-block mb-2">Member background</span>
        <% [["Beginner", "beginner"], ["Mixed", "mixed"], ["Experienced", "experienced"]].each do |label, value| %>
          <div class="form-check form-check-inline">
            <%= f.radio_button :member_background, value,
                  class: "form-check-input",
                  id: "ring_member_background_#{value}" %>
            <%= f.label "member_background_#{value}", label, class: "form-check-label" %>
          </div>
        <% end %>
        <% if @ring.errors[:member_background].any? %>
          <div class="text-danger small mt-1"><%= @ring.errors[:member_background].first %></div>
        <% end %>
      </div>

      <div class="mb-4">
        <span class="form-label fw-semibold d-block mb-2">Meeting frequency</span>
        <% [["Weekly", "weekly"], ["Biweekly", "biweekly"]].each do |label, value| %>
          <div class="form-check form-check-inline">
            <%= f.radio_button :meeting_frequency, value,
                  class: "form-check-input",
                  id: "ring_meeting_frequency_#{value}" %>
            <%= f.label "meeting_frequency_#{value}", label, class: "form-check-label" %>
          </div>
        <% end %>
        <% if @ring.errors[:meeting_frequency].any? %>
          <div class="text-danger small mt-1"><%= @ring.errors[:meeting_frequency].first %></div>
        <% end %>
      </div>

      <div class="mb-4">
        <%= f.label :purpose, "Purpose", class: "form-label fw-semibold" %>
        <%= f.text_area :purpose, rows: 2,
              class: "form-control #{"is-invalid" if @ring.errors[:purpose].any?}",
              placeholder: "One sentence. Why does this ring exist?" %>
        <div class="form-text">One sentence. Why does this ring exist?</div>
        <% if @ring.errors[:purpose].any? %>
          <div class="invalid-feedback"><%= @ring.errors[:purpose].first %></div>
        <% end %>
      </div>

      <%= f.submit "Create ring", class: "btn btn-accent btn-lg" %>
    <% end %>
  </div>
</div>
