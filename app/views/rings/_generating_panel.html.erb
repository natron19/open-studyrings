<div data-curriculum-generator-target="loading" class="text-center py-5" hidden>
  <div class="spinner-border text-warning mb-3" style="width: 3rem; height: 3rem;" role="status">
    <span class="visually-hidden">Generating…</span>
  </div>
  <h5 class="mb-2">Building your curriculum</h5>
  <p class="text-muted mb-1">Drafting your charter and six sessions&hellip;</p>
  <p class="text-muted small mb-4">This usually takes 15–30 seconds.</p>
  <button type="button" class="btn btn-outline-secondary btn-sm"
          data-action="click->curriculum-generator#cancel">
    Cancel
  </button>
</div>
