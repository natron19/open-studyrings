<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">My Rings</h1>
  <%= link_to "New Ring", new_ring_path, class: "btn btn-accent" %>
</div>

<% if @rings.empty? %>
  <%# Empty state %>
  <div class="text-center py-5">
    <p class="lead text-muted mb-4">Your first ring is one click away.</p>

    <div class="row justify-content-center mb-4">
      <div class="col-lg-7">
        <div class="card border-secondary">
          <div class="card-header text-muted small">
            Example ring — <em>Network theory and how communities actually organize</em>
          </div>
          <div class="card-body">
            <p class="small">
              This ring studies how network theory explains — and fails to explain — the way
              human communities actually form, sustain, and dissolve.
            </p>
            <div class="row g-3">
              <div class="col-md-6">
                <h6 class="text-muted small text-uppercase">Learning goals</h6>
                <ul class="small mb-0">
                  <li>Articulate the core claims of network theory</li>
                  <li>Apply network concepts to a real community you know</li>
                  <li>Evaluate where the theory breaks down</li>
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="text-muted small text-uppercase">Week 1 guiding question</h6>
                <p class="small fst-italic mb-0">
                  "What do we already believe about how communities form?"
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%= link_to "Create your first Ring →", new_ring_path, class: "btn btn-accent btn-lg" %>
  </div>

<% else %>
  <%# Card grid %>
  <div class="row g-4">
    <% @rings.each do |ring| %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 position-relative">
          <%# Status badge %>
          <% badge_class, badge_text = case ring.status
             when "draft"      then ["bg-secondary", "Not started"]
             when "generating" then ["text-dark", "Generating..."]
             when "complete"   then ["text-dark", "Complete"]
             when "failed"     then ["bg-danger", "Failed"]
             end %>
          <span class="position-absolute top-0 end-0 m-2 badge <%= badge_class %>"
                <% if %w[generating complete].include?(ring.status) %>style="background-color: var(--accent);"<% end %>>
            <%= badge_text %>
          </span>

          <div class="card-body d-flex gap-3">
            <%= render "rings/concentric_ring_marker",
                  current_week: ring.learning_charter&.ring_sessions&.maximum(:week_number).to_i,
                  size: :md %>
            <div class="flex-grow-1">
              <h6 class="card-title mb-1"><%= ring.topic %></h6>
              <p class="text-muted small mb-1">
                <span class="badge bg-secondary me-1"><%= ring.member_background.capitalize %></span>
                <%= ring.meeting_frequency.capitalize %>
              </p>
              <p class="text-muted small mb-0">Created <%= time_ago_in_words(ring.created_at) %> ago</p>
            </div>
          </div>

          <%= link_to "", ring_path(ring), class: "stretched-link" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
