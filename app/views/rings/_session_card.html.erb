<%# locals: (session:) %>
<div class="accordion-item">
  <h2 class="accordion-header">
    <button class="accordion-button <%= session.week_number == 1 ? "" : "collapsed" %>"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#session-week-<%= session.week_number %>"
            aria-expanded="<%= session.week_number == 1 %>">
      <span class="badge bg-secondary" style="min-width: 4.5rem;">Week <%= session.week_number %></span>
      <span class="fw-semibold"><%= session.guiding_question %></span>
    </button>
  </h2>
  <div id="session-week-<%= session.week_number %>"
       class="accordion-collapse collapse <%= session.week_number == 1 ? "show" : "" %>">
    <div class="accordion-body">
      <h6 class="text-muted small text-uppercase">Resources</h6>
      <p class="text-muted small fst-italic mb-1">Suggested starting points. The ring chooses what to actually read.</p>
      <ul class="small mb-4">
        <% session.resources_list.each do |resource| %>
          <li><%= resource %></li>
        <% end %>
      </ul>

      <h6 class="text-muted small text-uppercase">Discussion Prompts</h6>
      <ol class="small mb-4">
        <% session.discussion_prompts_list.each do |prompt| %>
          <li><%= prompt %></li>
        <% end %>
      </ol>

      <h6 class="text-muted small text-uppercase">Inquiry Activity</h6>
      <p class="small fst-italic mb-0"><%= session.inquiry_activity %></p>
    </div>
  </div>
</div>
